local function getRequestFn()
	return (syn and syn.request) or request or http_request or (http and http.request) or (fluxus and fluxus.request)
end

-- true if the local player is in the group.
-- 1) GroupService: Roblox's own call, it waits properly and never freezes the game
-- 2) Player:IsInGroup (can stay cached until you rejoin)
-- 3) optional: the groups web API through the executor's request function. Always fresh, but on some
--    mobile executors this call blocks the whole game, so it is off unless USE_HTTP_CHECK = true
local GroupService = game:GetService("GroupService")

local function isInGroup()
	local ok, groups = pcall(function() return GroupService:GetGroupsAsync(LocalPlayer.UserId) end)
	if ok and type(groups) == "table" then
		for _, g in ipairs(groups) do
			if type(g) == "table" and g.Id == GROUP_ID then return true end
		end
	end

	local ok2, result = pcall(function() return LocalPlayer:IsInGroup(GROUP_ID) end)
	if ok2 and result == true then return true end

	if USE_HTTP_CHECK then
		local req = getRequestFn()
		if req then
			local okReq, res = pcall(req, {
				Url = "https://groups.roblox.com/v2/users/" .. LocalPlayer.UserId .. "/groups/roles",
				Method = "GET",
			})
			if okReq and type(res) == "table" and type(res.Body) == "string" then
				local okJson, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
				if okJson and type(data) == "table" and type(data.data) == "table" then
					for _, entry in ipairs(data.data) do
						if type(entry) == "table" and type(entry.group) == "table" and entry.group.id == GROUP_ID then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

