-- after a successful check: leave the "verified" message up for a moment, fade the window out, clean up
closeForGood = function()
	task.wait(1.4)
	if isOpen then
		setShadow(false, 0.3)
		tween(window, 0.3, { GroupTransparency = 1 })
		tween(windowStroke, 0.3, { Transparency = 1 })
		tween(rootScale, 0.3, { Scale = fit * 0.94 })
	else
		tween(bubbleScale, 0.25, { Scale = 0 }) -- it was minimized: the bubble goes away instead
	end
	setBlur(0, 0.3)
	task.wait(2.2) -- the pop-up stays on screen for its full time
	unload()
end

