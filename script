		local started = os.clock()
		local result, finished
		task.spawn(function()
			result = isInGroup()
			finished = true
		end)
		while not finished and os.clock() - started < 10 do task.wait(0.1) end -- never stay stuck on "Checking..."
		local inGroup = finished and result == true
		local rest = 0.8 - (os.clock() - started) -- always show "Checking..." long enough to be seen
		if rest > 0 then task.wait(rest) end
		if inGroup then
			checkState = "done"
			renderCheck()
			tween(checkEdge, 0.2, { Color = C.success })
			showToast("verified", C.success)
			runUnlock()
