		if token ~= pageToken then return end
		new.Position = UDim2.fromOffset(SIDEBAR + 10, PAGE_Y)
		new.GroupTransparency = 1
		new.Visible = true
		tween(new, 0.22, { GroupTransparency = 0, Position = UDim2.fromOffset(SIDEBAR, PAGE_Y) })
